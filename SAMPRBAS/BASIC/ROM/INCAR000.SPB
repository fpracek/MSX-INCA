OPTION TARGET ROM_ASCII8
OPTION LABELS
' THE INCA WALL - SamPr Basic version, ROM cartridge (ASCII8). Same game as the .COM and .BIN (see ../BASIC): the routines of
' the original GOSUB program are SUBs spread in segments 1-3 (segment 0 keeps the DATA and the main loop).
' Take every red chakana, avoid the four guardians. 90 seconds a level, 3 lives; cursor keys or joystick, SPACE / fire starts.
DIM gb(524), fx(127), fs(6), ex(3), ef(3), ey(3), eg(3), edx(3), edy(3), rm(31), ms(127), mz(17), pr(63), dd(17), t8(255), ecol(3)
SCREEN 1, 2
COLOR 15, 1, 1
CALL setup
CALL title
lt = TIMER
DO
WHILE TIMER = lt : WEND
lt = TIMER
frm = frm + 1
CALL sfxtick
SELECT CASE st
CASE 0 : CALL runtitle
CASE 1 : CALL runready
CASE 2 : CALL runplay
CASE 3 : CALL rundie
CASE 4 : CALL runbonus
CASE 5 : CALL runover
END SELECT
LOOP

