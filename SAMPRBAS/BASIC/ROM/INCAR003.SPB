' Segment 3: sprites and HUD, play loop, death, bonus count and sound effects.

SUB sprites
 SHARED spr, pvis, px, py, pfr, ex, ey, ecol, frm, bardirty, bpx, huddirty, lives, sH, sL, hH, hL, lv
 spr = spr + 1 : IF spr > 4 THEN spr = 0
 q = spr
 FOR i = 0 TO 4
  IF i = 0 THEN
   IF pvis THEN PUT SPRITE q, (px, py), 15, pfr ELSE PUT SPRITE q, (0, 200), 15, 0
  ELSE
   PUT SPRITE q, (ex(i - 1), ey(i - 1)), ecol(i - 1), 2 + ((frm AND 16) <> 0)
  END IF
  q = q + 1 : IF q > 4 THEN q = 0
 NEXT i
 IF bardirty THEN
  bardirty = 0
  w = bpx AND 7 : n = bpx \ 8
  a$ = ""
  FOR k = 1 TO n : a$ = a$ + CHR$(112 + 7) : NEXT k
  IF w > 0 AND n < 32 THEN a$ = a$ + CHR$(112 + w - 1) : n = n + 1
  FOR k = n + 1 TO 32 : a$ = a$ + CHR$(96) : NEXT k
  c = 145 : IF bpx > 64 THEN c = 177
  IF bpx > 128 THEN c = 49
  VPOKE 8192 + 14, c
  VWRITE 6144 + 21 * 32, a$
 END IF
 IF huddirty THEN
  huddirty = 0
  a$ = ""
  FOR k = 1 TO lives : a$ = a$ + CHR$(120) : NEXT k
  a$ = LEFT$(a$ + "    ", 4) + MID$(STR$(sH + 100), 3) + MID$(STR$(sL + 10000), 3) + " HI "
  a$ = a$ + MID$(STR$(hH + 100), 3) + MID$(STR$(hL + 10000), 3) + "  LV "
  l = lv : IF l > 99 THEN l = 99
  VWRITE 6144 + 22 * 32, a$ + MID$(STR$(l + 100), 3)
 END IF
END SUB

SUB die
 SHARED st, tm, sfn
 st = 3 : tm = 110
 sfn = 4 : CALL sfxplay
END SUB

SUB runplay
 SHARED px, py, pan, pfr, dd, red, st, tl, ex, ey
 d = STICK(0) : IF d = 0 THEN d = STICK(1)
 IF d > 0 THEN
  px = px + dd(d + d) * 2 : py = py + dd(d + d + 1) * 2
  IF px < 0 THEN px = 0
  IF px > 240 THEN px = 240
  IF py < 0 THEN py = 0
  IF py > 144 THEN py = 144
  pan = pan + 1
  IF (pan AND 8) = 0 THEN pfr = 0 ELSE pfr = 1
 END IF
 CALL enemies
 CALL pickup
 CALL sprites
 IF red = 0 THEN
  st = 4
  EXIT SUB
 END IF
 CALL tick
 IF tl < 0 THEN
  CALL die
  EXIT SUB
 END IF
 FOR i = 0 TO 3
  IF ABS(ex(i) - px) < 12 AND ABS(ey(i) - py) < 12 THEN
   CALL die
   EXIT SUB
  END IF
 NEXT i
END SUB

SUB rundie
 SHARED frm, pvis, tm, lives, huddirty, msg$, mc, st, sfn
 IF (frm AND 4) = 0 THEN pvis = 0 ELSE pvis = 1
 CALL sprites
 tm = tm - 1
 IF tm = 0 THEN
  pvis = 1
  lives = lives - 1
  huddirty = 1
  IF lives = 0 THEN
   CALL sprites
   FOR i = 0 TO 4 : PUT SPRITE i : NEXT i
   msg$ = "GAME OVER" : mc = 11 : CALL msgshow
   st = 5 : tm = 180
   sfn = 5 : CALL sfxplay
  ELSE
   CALL actors
   CALL ready
  END IF
 END IF
END SUB

SUB runover
 SHARED tm
 tm = tm - 1
 IF tm = 0 THEN CALL title
END SUB

SUB runbonus
 SHARED secs2, tl, lv, p, sfn
 CALL sprites
 FOR k = 1 TO 15
  l = secs2
  CALL tick
  IF secs2 <> l THEN
   p = 10 : CALL addscore
   sfn = 2 : CALL sfxplay
  END IF
 NEXT k
 IF tl <= 0 THEN
  IF lv < 255 THEN lv = lv + 1
  CALL levelstart
 END IF
END SUB

SUB sfxplay
 SHARED sprio, sp, sw, fs, sfn
 IF sprio = 0 THEN sp = fs(sfn) : sw = 0
END SUB

SUB sfxplayhi
 SHARED sp, sw, sprio, fs, sfn
 sp = fs(sfn) : sw = 0 : sprio = 44
END SUB

SUB sfxtick
 SHARED sprio, sw, sp, fx
 IF sprio > 0 THEN sprio = sprio - 1
 IF sw > 0 THEN
  sw = sw - 1
  EXIT SUB
 END IF
 IF sp = 0 THEN EXIT SUB
 n = fx(sp)
 IF n = 0 THEN
  SOUND 8, 0 : sp = 0
  EXIT SUB
 END IF
 sw = n - 1
 SOUND 0, fx(sp + 1) : SOUND 1, fx(sp + 2) : SOUND 8, fx(sp + 3)
 sp = sp + 4
END SUB
